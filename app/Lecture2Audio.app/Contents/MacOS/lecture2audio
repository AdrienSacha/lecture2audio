#!/bin/zsh
# Double-click launcher: starts the local server of this checkout and opens the page.
# The bundle lives in <repo>/app/, so the repository is three folders up from this script.
REPO="${0:A:h:h:h:h}"
cd "$REPO" || exit 1
exec "$REPO/.venv/bin/python" -m lecture2audio app --out "$REPO/out"
