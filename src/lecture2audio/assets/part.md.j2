---
title: {{ fm(title) }}
part: {{ part.id }}
tags: [course, part]
{% if prev %}
prev: {{ fm("[[" ~ prev ~ "]]") }}
{% endif %}
{% if next %}
next: {{ fm("[[" ~ next ~ "]]") }}
{% endif %}
---
# {{ part.id }}. {{ title }}

{% if part_audio_file %}
![[audio/{{ part_audio_file }}]]

{% endif %}
{% if intro %}
{{ intro }}

{% endif %}
{% if prerequisites %}
> [!info]- {{ labels.needs }}
> {{ prerequisites|join(", ") }}

{% endif %}
{% for group in groups %}
{% if group.heading %}
{{ "#" * group.depth }} {{ group.heading }}

{% endif %}
{% for card in group.cards %}
{{ "#" * (group.depth + 1) }} {{ card.title }}

{% if card.plain %}
> [!abstract] {{ labels.plain }}
{{ card.plain|quote }}

{% endif %}
{% if card.external %}
> [!note] {{ labels.external }}
> {{ labels.external_text }} {{ card.sources|join(", ") }}

{% endif %}
{% if card.definition %}
> [!definition] {{ labels[card.kind] }}
{{ card.definition|quote }}

{% endif %}
{% if card.instance %}
**{{ labels.instance }}.** {{ card.instance }}

{% endif %}
{% for paragraph in card.explanation %}
{{ paragraph }}

{% endfor %}
{% for formula in card.formulas %}
$$
{{ formula }}
$$

{% endfor %}
{% if card.notation %}
| {{ labels.symbol }} | {{ labels.meaning }} |
|---|---|
{% for n in card.notation %}
| ${{ n.symbol }}$ | {{ n.meaning }} |
{% endfor %}

{% endif %}
{% if card.example %}
> [!example] {{ labels.example }}: {{ card.example.title }}
{% for step in card.example.steps %}
> {{ loop.index }}. {{ step }}
{% endfor %}

{% endif %}
{% if card.proof %}
> [!proof] {{ labels.proof }}
{% for step in card.proof %}
> {{ loop.index }}. {{ step }}
{% endfor %}
> ∎

{% endif %}
{% if card.diagram %}
{% if card.diagram.title %}
**{{ card.diagram.title }}**

{% endif %}
{% for frame in card.diagram.frames %}
> [!figure] {{ labels.step }} {{ loop.index }} / {{ loop.length }}
> {{ frame.caption }}
>
{% if frame.mermaid %}
{{ ("```mermaid\n" ~ frame.mermaid ~ "\n```")|quote }}
{% else %}
{{ ("```text\n" ~ frame.ascii ~ "\n```")|quote }}
{% endif %}

{% endfor %}
{% endif %}
{% for snippet in card.code %}
{% if snippet.caption %}
*{{ snippet.caption }}*

{% endif %}
```{{ snippet.language }}
{{ snippet.code }}
```

{% endfor %}
{% if card.table %}
{% if card.table.caption %}
*{{ card.table.caption }}*

{% endif %}
| {{ card.table.columns|join(" | ") }} |
|{% for _ in card.table.columns %}---|{% endfor %}

{% for row in card.table.rows %}
| {{ row|join(" | ") }} |
{% endfor %}

{% endif %}
{% if card.illustrative %}
*{{ labels.illustration }}*

{% endif %}
{% for check in card.checks %}
> [!question]- {{ check.question }}
{{ check.answer|quote }}

{% endfor %}
{% endfor %}
{% endfor %}
{% if exercises %}
## {{ labels.exercises }}

{% for exercise in exercises %}
**{{ labels.exercise }} {{ loop.index }}.** {{ exercise.question }}

> [!check]- {{ labels.solution }}
{% for step in exercise.steps %}
> {{ loop.index }}. {{ step }}
{% endfor %}
>
> **{{ labels.answer }}:** {{ exercise.answer }}

{% endfor %}
{% endif %}
{% if review %}
## {{ labels.review }}

{% for item in review %}
> [!question]- {{ item.question }} ({{ item.link }})
{{ item.answer|quote }}

{% endfor %}
{% endif %}
{% if prev or next %}
---
{% if prev %}{{ labels.previous }}: [[{{ prev }}]]{% endif %}{% if prev and next %} · {% endif %}{% if next %}{{ labels.next }}: [[{{ next }}]]{% endif %}

{% endif %}
